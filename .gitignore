# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage

# PyInstaller output from building a release binary locally (see
# .github/workflows/release.yml, which builds the same way in CI and
# publishes the result to a GitHub Release -- these are build output, not
# something the repo itself ships).
build/
dist/
*.spec

# Player-saved custom levels (see persistence.py) -- local game data, not
# something the repo ships or tracks.
custom_levels/

# Which built-in levels the player has cleared (see progress.py) -- local
# game data, same spirit as custom_levels/.
progress.json

# Persisted player preferences (fullscreen, difficulty -- see
# player_settings.py) -- local game data, same spirit as progress.json.
player_settings.json

# Cumulative achievement counters/unlocks (see achievements.py) -- local
# game data, same spirit as progress.json.
achievements.json

# An in-progress run saved from the pause menu (see save_state.py) -- local
# game data, same spirit as progress.json.
save_state.json

# Cumulative meta-progression counters/tower unlocks for the roguelike run's
# draft pool (see meta_progression.py) -- local game data, same spirit as
# achievements.json.
meta_progression.json

# Best floors-cleared score per roguelike run seed, Daily Run included (see
# run_history.py) -- local game data, same spirit as progress.json.
run_history.json

# Claude Code local settings (machine/user-specific, not meant to be shared)
.claude/
CLAUDE.local.md

# Env / secrets
.env
.env.*
*.local

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
